# Optional Gemini analyst brief. The app uses a deterministic local brief when unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Optional Neo4j Detective provider. The app uses a labeled demo graph when unset.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j